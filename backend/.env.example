# Copia este archivo a .env y ajusta los valores.

# Cadena de conexión a MongoDB.
# - Atlas (nube):  mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/juguetondb?retryWrites=true&w=majority
# - Local/Docker:  mongodb://localhost:27017/juguetondb
MONGODB_URI="mongodb://localhost:27017/juguetondb"

# Puerto donde corre la API
PORT=3000

# Origen permitido para CORS (el frontend Angular)
CORS_ORIGIN="http://localhost:4200"
